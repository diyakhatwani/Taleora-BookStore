
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Placed - BookStore</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-[#f7f4ed] text-gray-900">
    <%- include('includes/nav.ejs') %>

    <main class="max-w-2xl mx-auto px-5 py-16">
        <div class="bg-white border border-[#e3ded4] rounded-xl p-8 text-center">

            <div class="w-16 h-16 mx-auto rounded-full bg-green-100 text-green-700 flex items-center justify-center text-3xl">
                ✓
            </div>

            <h1 class="text-3xl font-bold text-[#25483f] mt-5">
                Order Placed Successfully!
            </h1>

            <p class="text-gray-600 mt-3">
                Thank you for shopping with Read Me Book Store.
            </p>

            <div class="text-left bg-[#f7f4ed] p-5 rounded-lg mt-8 space-y-3">
                <div class="flex justify-between gap-4">
                    <span class="text-gray-600">Order ID</span>
                    <span class="font-medium break-all text-right"><%= order._id %></span>
                </div>

                <div class="flex justify-between gap-4">
                    <span class="text-gray-600">Book</span>
                    <span class="font-medium text-right"><%= order.bookTitle %></span>
                </div>

                <div class="flex justify-between gap-4">
                    <span class="text-gray-600">Total Amount</span>
                    <span class="font-bold text-[#25483f]">₹<%= order.price %></span>
                </div>

                <div class="flex justify-between gap-4">
                    <span class="text-gray-600">Payment</span>
                    <span class="font-medium">Cash on Delivery</span>
                </div>

                <div class="flex justify-between gap-4">
                    <span class="text-gray-600">Order Status</span>
                    <span class="font-semibold text-amber-700"><%= order.status %></span>
                </div>
            </div>

            <p class="text-sm text-gray-500 mt-5">
                Your order has been received. Thank you!
            </p>

            <a href="/books"
               class="inline-block mt-6 bg-[#25483f] hover:bg-[#19382f] text-white px-6 py-3 rounded-lg font-medium">
                Continue Shopping
            </a>
        </div>
    </main>

    <%- include('includes/footer.ejs') %>
</body>
</html>
